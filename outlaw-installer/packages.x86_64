# ============================================================================
# Outlaw Server — LIVE ISO package set
# ----------------------------------------------------------------------------
# Only what's needed to (a) boot the live environment, (b) run the Outlaw
# Server panel, and (c) install to disk. The desktop/gaming stack from Outlaw
# OS is deliberately gone: no audio, no Bluetooth, no browser, no game engine,
# no OCR, no compositor/taskbar/launcher eye-candy.
#
# Anything a specific server needs (Docker, Pterodactyl, Cockpit, …) installs
# on demand AFTER setup — the ISO stays small.
# ============================================================================

# --- Base system + boot -----------------------------------------------------
base
linux
linux-firmware
intel-ucode
amd-ucode
mkinitcpio
mkinitcpio-archiso
sudo
polkit
networkmanager
zram-generator

# --- Core CLI ---------------------------------------------------------------
curl
wget
git
nano
rsync
htop
pacman-contrib

# --- Remote access (a server without SSH is a brick) ------------------------
openssh

# Encrypted private networking. This is how the control panel is reached from
# anywhere without putting it on the public internet: the panel listens on the
# tunnel address, and WireGuard encrypts everything end to end.
#   tailscale       — managed WireGuard. Free tier (100 devices), open source.
#   wireguard-tools — for admins who'd rather self-host and involve no third
#                     party at all. Both are supported; neither costs money.
# NEITHER runs by default. `outlaw remote up` starts and enables tailscaled;
# until then nothing is listening and nothing is phoning anywhere.
tailscale
wireguard-tools

# --- Bootloader + installer tooling ----------------------------------------
syslinux
grub
efibootmgr
os-prober
dosfstools
mtools
arch-install-scripts
gptfdisk
parted
gparted
ntfs-3g
memtest86+
memtest86+-efi
edk2-shell

# --- Security ---------------------------------------------------------------
apparmor
firejail
ufw

# --- Minimal X + the panel --------------------------------------------------
# X only exists so the machine can show its own control panel on an attached
# monitor. Headless boxes never start it — they're managed from a browser.
# openbox is optional (the panel runs kiosk-style without a WM); xfce4-terminal
# backs the "open a real terminal" helper.
xorg-server
xorg-xinit
xf86-video-vesa
xf86-video-fbdev
mesa
openbox
xfce4-terminal
electron
fuse2
ttf-jetbrains-mono
noto-fonts

# --- The control daemon -----------------------------------------------------
# outlaw-serverd runs on plain Node with ZERO npm dependencies, so this single
# package is the entire runtime for the control panel + the `outlaw` CLI.
nodejs

# --- Build tooling (AUR helper + on-demand server software) -----------------
base-devel
python
