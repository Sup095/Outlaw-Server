# ============================================================================
# Outlaw OS — daily quick diagnostic
# Runs every day at 03:00 local time. Tied to outlaw-diagnose@quick.service.
# Disabled by default; user opts in from System Core → Diagnostics → Schedule.
# ============================================================================

[Unit]
Description=Outlaw OS daily quick diagnostic
Documentation=man:outlaw-diagnose(1)

[Timer]
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=15min
Persistent=true
Unit=outlaw-diagnose@quick.service

[Install]
WantedBy=timers.target
