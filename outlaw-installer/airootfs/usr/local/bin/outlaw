#!/usr/bin/env bash
# ============================================================================
# outlaw — the Outlaw Server command line
# ----------------------------------------------------------------------------
# Everything the control panel can do, from a terminal. This is the WHOLE
# interface in `lean` mode (no UI, no listener), and a convenience in panel
# mode. It talks to the same operations registry the panel does, so the two can
# never drift apart.
#
# In lean mode nothing is listening, so we run the operation directly through
# Node instead of over HTTP — no daemon required.
# ============================================================================
set -uo pipefail

# Overridable so the CLI can be exercised outside a real install; the defaults
# are the only paths that exist on a real one.
SERVERD_DIR="${OUTLAW_SERVERD_DIR:-/usr/share/outlaw-serverd}"
CONFIG="${OUTLAW_SERVERD_CONFIG:-/etc/outlaw-server/daemon.json}"

usage() {
    cat <<'USAGE'
outlaw — Outlaw Server control

  outlaw status              Machine summary (host, kernel, CPU, RAM, uptime)
  outlaw stats               Live CPU load / RAM / uptime
  outlaw disk                Filesystem usage
  outlaw services            List systemd services
  outlaw start   <unit>      Start a service
  outlaw stop    <unit>      Stop a service
  outlaw restart <unit>      Restart a service
  outlaw enable  <unit>      Enable a service at boot
  outlaw disable <unit>      Disable a service at boot
  outlaw logs [unit] [n]     Recent journal lines (default 200)
  outlaw mode [panel|lean]   Show or set the control-panel mode
  outlaw passwd [user]       Set the panel password (creates the admin, prints
                             the 2FA secret to enrol in your authenticator app)
  outlaw 2fa <user> <code>   Confirm 2FA — required before it is enforced
  outlaw audit [n]           Recent sign-in / privileged-action records
  outlaw keyboard            Keyboard layout: status | list | set <layout>
                             (sets the text console AND the panel — this is what
                             you type the root password with)
  outlaw help                This text

Remote access (reach this machine from anywhere, over an encrypted tunnel):
  outlaw remote              Where things stand
  outlaw remote up [--ssh]   Join your Tailscale network (prints a sign-in link)
  outlaw remote down         Leave the tailnet (tailscaled keeps running)
  outlaw remote off          Leave AND stop tailscaled — back to nothing running
  outlaw remote bind <where> loopback | tunnel | <address>
  outlaw remote serve on|off Front the panel with HTTPS inside your tailnet

Modes:
  panel  browser control panel on http://127.0.0.1:7717 (easiest to configure)
  lean   no UI and no listener at all — SSH + this command only
USAGE
}

# Run one operation through the shared registry and pretty-print the JSON.
op() {
    local name="$1"; shift
    local args="${1:-{\}}"
    node -e '
        const { dispatch } = require(process.argv[1] + "/ops");
        const [, , name, argsJson] = process.argv;
        let args = {};
        try { args = JSON.parse(argsJson || "{}"); } catch {}
        dispatch(name, args, { version: "cli", mode: "cli", bind: "-" })
          .then((r) => { console.log(JSON.stringify(r, null, 2)); process.exit(r && r.ok === false ? 1 : 0); })
          .catch((e) => { console.error("error:", e.message); process.exit(1); });
    ' "$SERVERD_DIR" "$name" "$args"
}

svc() {
    local action="$1" unit="${2:-}"
    if [[ -z "$unit" ]]; then echo "usage: outlaw $action <unit>" >&2; exit 2; fi
    # Refuse anything that isn't a plausible unit name before it is pasted into
    # a JSON string — a quote here would produce malformed JSON, not an error.
    if [[ ! "$unit" =~ ^[A-Za-z0-9][A-Za-z0-9._@-]*$ ]]; then
        echo "not a valid unit name: $unit" >&2; exit 2
    fi
    op "services:action" "$(printf '{"unit":"%s","action":"%s"}' "$unit" "$action")"
}

# Human-readable remote-access summary. The JSON from `remote:status` is the
# machine-readable version; this is the one an admin reads at 2am.
remote_status() {
    node -e '
        const remote = require(process.argv[1] + "/remote");
        const config = require(process.argv[1] + "/config");
        remote.status(config.load()).then((s) => {
            const ts = s.tailscale;
            const state = !ts.installed ? "not installed"
                : ts.connected ? "connected"
                : ts.running ? (ts.state || "running, not signed in")
                : "stopped";
            console.log("Remote access");
            console.log("  Tailscale   : " + state);
            if (ts.ipv4)     console.log("  This machine: " + ts.ipv4 + (ts.dnsName ? "  (" + ts.dnsName + ")" : ""));
            if (ts.peers)    console.log("  Tailnet     : " + ts.peers + " other device(s)");
            if (ts.authUrl)  console.log("  Sign in at  : " + ts.authUrl);
            if (s.wireguard.interfaces.length) console.log("  WireGuard   : " + s.wireguard.interfaces.join(", "));
            console.log("  Panel binds : " + s.bind.host + ":" + s.bind.port + "  [" + s.bind.kind + (s.bind.allowed ? "" : " — REFUSED") + "]");
            if (s.serve.enabled) console.log("  HTTPS proxy : on (tailscale serve)");
            if (s.reachableAt.length) {
                console.log("");
                console.log("  Reachable at:");
                for (const r of s.reachableAt) console.log("    " + r.url + "   — " + r.from);
            }
            if (!s.bind.allowed) {
                console.log("");
                console.log("  The daemon will REFUSE to start: " + s.bind.reason);
                console.log("  Fix it with: sudo outlaw remote bind loopback");
            } else if (ts.hint) {
                console.log("");
                console.log("  " + ts.hint);
            }
        }).catch((e) => { console.error("error:", e.message); process.exit(1); });
    ' "$SERVERD_DIR"
}

need_root() {
    if [[ $EUID -ne 0 ]]; then echo "that needs root: sudo outlaw $*" >&2; exit 1; fi
}

case "${1:-help}" in
    status)   op "system:info" ;;
    stats)    op "system:stats" ;;
    disk)     op "system:disk" ;;
    services) op "services:list" ;;
    start|stop|restart|enable|disable) svc "$1" "${2:-}" ;;
    logs)
        unit="${2:-}"; lines="${3:-200}"
        if [[ -n "$unit" ]]; then
            op "logs:recent" "$(printf '{"unit":"%s","lines":%s}' "$unit" "$lines")"
        else
            op "logs:recent" "$(printf '{"lines":%s}' "$lines")"
        fi
        ;;
    mode)
        want="${2:-}"
        if [[ -z "$want" ]]; then
            if [[ -r "$CONFIG" ]]; then
                node -e 'try{console.log(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).mode||"panel")}catch{console.log("panel (no config)")}' "$CONFIG"
            else
                echo "panel (no config file yet)"
            fi
            exit 0
        fi
        if [[ "$want" != "panel" && "$want" != "lean" ]]; then
            echo "mode must be 'panel' or 'lean'" >&2; exit 2
        fi
        if [[ $EUID -ne 0 ]]; then echo "changing the mode needs root: sudo outlaw mode $want" >&2; exit 1; fi
        mkdir -p "$(dirname "$CONFIG")"
        node -e '
            const fs = require("fs");
            const [, , p, mode] = process.argv;
            let cfg = {};
            try { cfg = JSON.parse(fs.readFileSync(p, "utf8")); } catch {}
            cfg.mode = mode;
            fs.writeFileSync(p, JSON.stringify(cfg, null, 2) + "\n");
        ' "$CONFIG" "$want" || { echo "could not write $CONFIG" >&2; exit 1; }
        systemctl restart outlaw-serverd 2>/dev/null || true
        if [[ "$want" = "panel" ]]; then
            echo "Panel mode. Control panel: http://127.0.0.1:7717"
        else
            echo "Lean mode. Nothing is listening — manage this server over SSH or with 'outlaw'."
        fi
        ;;
    passwd)
        user="${2:-admin}"
        if [[ $EUID -ne 0 ]]; then echo "setting the panel password needs root: sudo outlaw passwd $user" >&2; exit 1; fi
        # Read the password without echoing it, and never pass it as an argv
        # element (argv is world-readable via /proc). It goes in on stdin.
        read -rsp "New panel password for '$user' (min 10 chars): " pw1; echo
        read -rsp "Repeat: " pw2; echo
        if [[ "$pw1" != "$pw2" ]]; then echo "Passwords did not match." >&2; exit 1; fi
        printf '%s' "$pw1" | node -e '
            let pw = "";
            process.stdin.on("data", (d) => { pw += d; });
            process.stdin.on("end", () => {
                const auth = require(process.argv[1] + "/auth");
                const r = auth.setUser(process.argv[2], pw);
                if (!r.ok) { console.error(r.error); process.exit(1); }
                console.log("\nPassword set for " + r.user + ".");
                if (r.totpSecret) {
                    console.log("\n  Two-factor secret : " + r.totpSecret);
                    console.log("  Or scan/paste     : " + r.totpUri);
                    console.log("\n  Add that to a free authenticator app (Aegis, Google Authenticator,");
                    console.log("  Ente Auth), then confirm it — 2FA is NOT enforced until you do,");
                    console.log("  so a mistyped secret cannot lock you out:");
                    console.log("\n      sudo outlaw 2fa " + r.user + " <6-digit code>\n");
                }
            });
        ' "$SERVERD_DIR" "$user"
        unset pw1 pw2
        ;;
    2fa)
        user="${2:-}"; code="${3:-}"
        if [[ -z "$user" || -z "$code" ]]; then echo "usage: outlaw 2fa <user> <6-digit code>" >&2; exit 2; fi
        if [[ $EUID -ne 0 ]]; then echo "confirming 2FA needs root: sudo outlaw 2fa $user $code" >&2; exit 1; fi
        node -e '
            const auth = require(process.argv[1] + "/auth");
            const r = auth.confirmTotp(process.argv[2], process.argv[3]);
            if (!r.ok) { console.error(r.error); process.exit(1); }
            console.log("Two-factor authentication confirmed and now REQUIRED at sign-in.");
        ' "$SERVERD_DIR" "$user" "$code"
        ;;
    keyboard|kb)
        # Which physical keyboard is plugged into THIS machine. Matters most at
        # the text console, where the root password is typed and there is no
        # panel to fall back on — so it has to work in lean mode too.
        case "${2:-status}" in
            status|"")
                node -e '
                    const { dispatch } = require(process.argv[1] + "/ops");
                    dispatch("keyboard:status", {}, {}).then((r) => {
                        if (!r.available) { console.error(r.error || "unavailable"); process.exit(1); }
                        console.log("Panel (X11):   " + (r.x11 || "unknown"));
                        console.log("Text console:  " + (r.console || "unknown"));
                        console.log("");
                        console.log(r.layouts.length + " layouts available — `outlaw keyboard list` to see them.");
                    });
                ' "$SERVERD_DIR"
                ;;
            list)
                node -e '
                    const { dispatch } = require(process.argv[1] + "/ops");
                    dispatch("keyboard:status", {}, {}).then((r) => {
                        if (!r.available) { console.error(r.error || "unavailable"); process.exit(1); }
                        for (const l of r.layouts) {
                            console.log("  " + l.code.padEnd(10) + (l.label === l.code ? "" : l.label));
                        }
                    });
                ' "$SERVERD_DIR"
                ;;
            set)
                want="${3:-}"
                if [[ -z "$want" ]]; then echo "usage: outlaw keyboard set <layout>   (see: outlaw keyboard list)" >&2; exit 2; fi
                need_root keyboard set "$want"
                op "keyboard:set" "$(printf '{"layout":"%s"}' "$want")"
                ;;
            *)
                echo "usage: outlaw keyboard {status|list|set <layout>}" >&2; exit 2 ;;
        esac
        ;;
    remote)
        case "${2:-status}" in
            status)
                remote_status
                ;;
            up)
                need_root remote up
                if ! command -v tailscale >/dev/null 2>&1; then
                    echo "Tailscale isn't installed yet. Install it with:" >&2
                    echo "    sudo pacman -S tailscale" >&2
                    exit 1
                fi
                # tailscaled has to be up before the CLI can talk to it, and
                # enabled so remote access survives a reboot — which is rather
                # the point.
                systemctl enable --now tailscaled || { echo "could not start tailscaled" >&2; exit 1; }
                echo "Joining your Tailscale network."
                echo "A sign-in link will appear below — open it in any browser, on any device."
                echo
                # Run it in the foreground: it prints the URL and waits for you
                # to authenticate, which is exactly the behaviour we want here.
                if [[ "${3:-}" = "--ssh" ]]; then
                    tailscale up --ssh || exit 1
                else
                    tailscale up || exit 1
                fi
                echo
                echo "Connected. Next, choose where the panel listens:"
                echo "    sudo outlaw remote bind tunnel     # reachable from your tailnet"
                echo "    sudo outlaw remote serve on        # ...and with HTTPS + a real name"
                ;;
            down)
                need_root remote down
                tailscale down || exit 1
                echo "Disconnected from the tailnet. tailscaled is still running."
                echo "To stop it entirely: sudo outlaw remote off"
                ;;
            off)
                need_root remote off
                tailscale down 2>/dev/null || true
                systemctl disable --now tailscaled || exit 1
                # The panel must not be left pointing at an address that no
                # longer exists, or the daemon refuses to start on next boot.
                op "remote:bind" '{"target":"loopback"}' >/dev/null || true
                systemctl restart outlaw-serverd 2>/dev/null || true
                echo "Remote access off. Nothing is running, and the panel is back on loopback."
                ;;
            bind)
                target="${3:-}"
                if [[ -z "$target" ]]; then echo "usage: outlaw remote bind <loopback|tunnel|address>" >&2; exit 2; fi
                if [[ ! "$target" =~ ^[A-Za-z0-9:._-]+$ ]]; then echo "not a valid target: $target" >&2; exit 2; fi
                need_root remote bind "$target"
                op "remote:bind" "$(printf '{"target":"%s"}' "$target")" || exit 1
                systemctl restart outlaw-serverd 2>/dev/null || true
                remote_status
                ;;
            serve)
                want="${3:-}"
                if [[ "$want" != "on" && "$want" != "off" ]]; then echo "usage: outlaw remote serve <on|off>" >&2; exit 2; fi
                need_root remote serve "$want"
                if [[ "$want" = "on" ]]; then
                    op "remote:serve" '{"enabled":true}' || exit 1
                else
                    op "remote:serve" '{"enabled":false}' || exit 1
                fi
                systemctl restart outlaw-serverd 2>/dev/null || true
                remote_status
                ;;
            *)
                echo "unknown: outlaw remote ${2:-}" >&2
                echo "try: status | up | down | off | bind | serve" >&2
                exit 2
                ;;
        esac
        ;;
    audit)
        n="${2:-40}"
        f="/var/lib/outlaw-server/audit.log"
        if [[ ! -r "$f" ]]; then echo "No audit log yet (nothing has signed in)."; exit 0; fi
        tail -n "$n" "$f"
        ;;
    help|-h|--help) usage ;;
    *) echo "unknown command: $1" >&2; echo; usage; exit 2 ;;
esac
