#!/usr/bin/env bash
# ============================================================================
# outlaw-pterodactyl — guided Pterodactyl install
# ----------------------------------------------------------------------------
# Pterodactyl is NOT a one-click install and this script does not pretend
# otherwise. It is a web application with a database, a PHP runtime, a web
# server, a queue worker and a cron entry, plus a SEPARATE daemon (wings) that
# runs the game servers themselves. A button that half-does that and leaves a
# broken web stack is worse than no button.
#
# So: every step is named, printed before it runs, and the FIRST failure stops
# the script with the real error. Nothing is silently skipped, nothing is
# silently retried, and the script says plainly what it changed. It is readable
# on purpose — you are handing it root, so you should be able to see what it does.
#
# It is also written to be RE-RUNNABLE. Every step checks whether its work is
# already done, so a run that dies halfway (bad network, wrong FQDN) can be
# fixed and started again without tearing anything down.
#
# WHAT IT DOES NOT DO
#   * It does not obtain a TLS certificate. That needs a real domain pointing at
#     this machine and is a decision (and a rate limit) of its own.
#   * It does not open the firewall. `outlaw remote`/the Firewall screen own that,
#     and quietly exposing a new port would defeat the point of having them.
#   * It does not configure wings' node settings — those are generated BY the
#     panel, after you create a node in it. `outlaw-pterodactyl wings` installs
#     the daemon and tells you where to paste that config.
#
# Usage:
#   outlaw-pterodactyl panel --fqdn panel.example.com --email you@example.com
#   outlaw-pterodactyl wings
#   outlaw-pterodactyl status
# ============================================================================
set -uo pipefail

PANEL_DIR=/var/www/pterodactyl
DB_NAME=panel
DB_USER=pterodactyl
NGINX_SITE=/etc/nginx/conf.d/pterodactyl.conf

die()  { printf '\n\033[1;31mFAILED:\033[0m %s\n' "$*" >&2; exit 1; }
step() { printf '\n\033[1;36m==>\033[0m %s\n' "$*"; }
note() { printf '    %s\n' "$*"; }
ok()   { printf '\033[1;32m  ok\033[0m %s\n' "$*"; }

need_root() { [[ $EUID -eq 0 ]] || die "this needs root — try: sudo outlaw-pterodactyl $*"; }

# Run a command, showing it first. Any non-zero exit stops the script.
run() {
    note "\$ $*"
    "$@" || die "command failed: $*"
}

usage() {
    cat <<'USAGE'
outlaw-pterodactyl — guided Pterodactyl install

  outlaw-pterodactyl panel --fqdn <name> --email <address>
        Installs the Pterodactyl PANEL (the web UI): PHP, MariaDB, nginx,
        Redis, the panel itself, a queue worker and the scheduler cron.
        --fqdn   the hostname people will open the panel at. On a private
                 tailnet this is usually your machine's *.ts.net name.
        --email  the address for the first administrator account.

  outlaw-pterodactyl wings
        Installs WINGS, the daemon that actually runs game servers in Docker.
        Needs Docker. Its node config is generated by the panel afterwards.

  outlaw-pterodactyl status
        What's installed and what's running.

Nothing here opens a firewall port. Use the Firewall screen (or `ufw`) when
you've decided what should be reachable.
USAGE
}

# --------------------------------------------------------------------------
status_report() {
    printf 'Pterodactyl\n'
    if [[ -d "$PANEL_DIR" ]]; then
        printf '  Panel      : installed at %s\n' "$PANEL_DIR"
    else
        printf '  Panel      : not installed\n'
    fi
    for u in mariadb redis nginx php-fpm pteroq wings; do
        if systemctl list-unit-files --no-legend --no-pager --plain 2>/dev/null | awk '{print $1}' | grep -qx "$u.service"; then
            printf '  %-10s : %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null)"
        fi
    done
    if command -v docker >/dev/null 2>&1; then
        printf '  docker     : %s\n' "$(systemctl is-active docker 2>/dev/null)"
    else
        printf '  docker     : not installed\n'
    fi
}

# --------------------------------------------------------------------------
install_panel() {
    local FQDN="" EMAIL=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --fqdn)  FQDN="${2:-}"; shift 2 ;;
            --email) EMAIL="${2:-}"; shift 2 ;;
            *) die "unknown option: $1" ;;
        esac
    done
    [[ -n "$FQDN" ]]  || die "--fqdn is required (the hostname you'll open the panel at)"
    [[ -n "$EMAIL" ]] || die "--email is required (the first administrator's address)"
    # Validated because both are interpolated into an nginx config and a
    # database statement. Anything outside these shapes is REFUSED rather than
    # escaped — escaping is where this kind of thing goes wrong.
    # Checked before the root test on purpose: a malformed hostname should be
    # rejected immediately, not after someone has gone and found sudo.
    [[ "$FQDN"  =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$ ]] || die "that doesn't look like a hostname: $FQDN"
    [[ "$EMAIL" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || die "that doesn't look like an email address: $EMAIL"

    need_root panel --fqdn "$FQDN" --email "$EMAIL"

    step "Installing the packages Pterodactyl needs"
    run pacman -S --noconfirm --needed \
        php php-fpm php-gd php-sqlite php-redis \
        mariadb nginx redis composer git unzip curl tar cronie

    step "Enabling the PHP extensions the panel requires"
    # Arch ships php.ini with these commented out. Uncomment only the ones
    # Pterodactyl actually needs, and only if they're not already active.
    local INI=/etc/php/php.ini
    [[ -f "$INI" ]] || die "$INI not found — is php installed?"
    for ext in bcmath curl gd mbstring intl pdo_mysql zip fileinfo; do
        if grep -qE "^extension=$ext\$" "$INI"; then
            ok "$ext already enabled"
        else
            sed -i "s/^;extension=$ext\$/extension=$ext/" "$INI"
            grep -qE "^extension=$ext\$" "$INI" && ok "enabled $ext" || note "  (no $ext line in php.ini — it may be built in)"
        fi
    done

    step "Starting MariaDB"
    if [[ ! -d /var/lib/mysql/mysql ]]; then
        run mariadb-install-db --user=mysql --basedir=/usr --datadir=/var/lib/mysql
    else
        ok "database directory already initialised"
    fi
    run systemctl enable --now mariadb
    run systemctl enable --now redis
    run systemctl enable --now php-fpm
    run systemctl enable --now cronie

    step "Creating the panel database"
    local DB_PASS
    # Generated, never typed, never echoed to a terminal someone might be
    # screen-sharing. It is written only into the panel's own .env.
    DB_PASS="$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32)"
    if mariadb -e "USE $DB_NAME" 2>/dev/null; then
        note "database '$DB_NAME' already exists — resetting the application user's password"
    else
        run mariadb -e "CREATE DATABASE $DB_NAME CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
    fi
    mariadb -e "CREATE USER IF NOT EXISTS '$DB_USER'@'127.0.0.1' IDENTIFIED BY '$DB_PASS';" \
        || die "could not create the database user"
    mariadb -e "ALTER USER '$DB_USER'@'127.0.0.1' IDENTIFIED BY '$DB_PASS';" \
        || die "could not set the database password"
    mariadb -e "GRANT ALL PRIVILEGES ON $DB_NAME.* TO '$DB_USER'@'127.0.0.1' WITH GRANT OPTION; FLUSH PRIVILEGES;" \
        || die "could not grant database privileges"
    ok "database ready"

    step "Fetching the panel"
    install -d -m 755 "$PANEL_DIR"
    if [[ ! -f "$PANEL_DIR/artisan" ]]; then
        run curl -L -o /tmp/panel.tar.gz https://github.com/pterodactyl/panel/releases/latest/download/panel.tar.gz
        run tar -xzv -f /tmp/panel.tar.gz -C "$PANEL_DIR"
        rm -f /tmp/panel.tar.gz
    else
        ok "panel files already present"
    fi
    run chmod -R 755 "$PANEL_DIR/storage" "$PANEL_DIR/bootstrap/cache"

    step "Installing PHP dependencies (this is the slow part)"
    ( cd "$PANEL_DIR" && COMPOSER_ALLOW_SUPERUSER=1 composer install --no-dev --optimize-autoloader --no-interaction ) \
        || die "composer install failed"

    step "Configuring the panel"
    [[ -f "$PANEL_DIR/.env" ]] || run cp "$PANEL_DIR/.env.example" "$PANEL_DIR/.env"
    ( cd "$PANEL_DIR" && php artisan key:generate --force --no-interaction ) || die "could not generate the application key"
    ( cd "$PANEL_DIR" && php artisan p:environment:setup \
        --author="$EMAIL" --url="http://$FQDN" --timezone="$(timedatectl show -p Timezone --value 2>/dev/null || echo UTC)" \
        --cache=redis --session=redis --queue=redis \
        --redis-host=127.0.0.1 --redis-pass= --redis-port=6379 --no-interaction ) \
        || die "p:environment:setup failed"
    # KNOWN LIMITATION: artisan takes the password only as an argument, so for
    # the moment this command runs it is visible in /proc to any local user.
    # This is what Pterodactyl's own documented installer does, and the window
    # is a second or two — but it is a real exposure and worth knowing about on
    # a machine with untrusted local accounts. The password is random and used
    # only by the panel, so the blast radius is the panel's database.
    ( cd "$PANEL_DIR" && php artisan p:environment:database \
        --host=127.0.0.1 --port=3306 --database="$DB_NAME" --username="$DB_USER" --password="$DB_PASS" --no-interaction ) \
        || die "p:environment:database failed"

    step "Creating the database schema"
    ( cd "$PANEL_DIR" && php artisan migrate --seed --force --no-interaction ) || die "migrations failed"

    step "Setting file ownership for the web server"
    run chown -R http:http "$PANEL_DIR"

    step "Adding the scheduler and the queue worker"
    # The scheduler must tick every minute; without it, nothing scheduled in the
    # panel ever happens.
    if ! crontab -l 2>/dev/null | grep -q "$PANEL_DIR/artisan schedule:run"; then
        ( crontab -l 2>/dev/null; echo "* * * * * php $PANEL_DIR/artisan schedule:run >> /dev/null 2>&1" ) | crontab -
        ok "scheduler cron added"
    else
        ok "scheduler cron already present"
    fi
    cat > /etc/systemd/system/pteroq.service <<UNIT
[Unit]
Description=Pterodactyl queue worker
After=redis.service

[Service]
User=http
Group=http
Restart=always
ExecStart=/usr/bin/php $PANEL_DIR/artisan queue:work --queue=high,standard,low --sleep=3 --tries=3
StartLimitInterval=180
StartLimitBurst=30
RestartSec=5s

[Install]
WantedBy=multi-user.target
UNIT
    run systemctl daemon-reload
    run systemctl enable --now pteroq

    step "Configuring nginx"
    # Plain HTTP, bound to this machine. TLS is a separate decision that needs a
    # real certificate — see the note at the end.
    cat > "$NGINX_SITE" <<NGINX
server {
    listen 80;
    server_name $FQDN;
    root $PANEL_DIR/public;
    index index.php;

    access_log /var/log/nginx/pterodactyl.app-access.log;
    error_log  /var/log/nginx/pterodactyl.app-error.log error;
    client_max_body_size 100m;
    client_body_timeout 120s;
    sendfile off;

    location / { try_files \$uri \$uri/ /index.php?\$query_string; }

    location ~ \.php\$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)\$;
        fastcgi_pass unix:/run/php-fpm/php-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param PHP_VALUE "upload_max_filesize = 100M \n post_max_size=100M";
        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        fastcgi_intercept_errors off;
        fastcgi_buffer_size 16k;
        fastcgi_buffers 4 16k;
        fastcgi_connect_timeout 300;
        fastcgi_send_timeout 300;
        fastcgi_read_timeout 300;
    }

    location ~ /\.ht { deny all; }
}
NGINX
    # nginx.conf must actually include conf.d — a stock Arch nginx.conf does not
    # always. Check rather than assume, or the site silently never loads.
    if ! grep -q 'include .*conf\.d/\*\.conf' /etc/nginx/nginx.conf; then
        die "your /etc/nginx/nginx.conf does not include conf.d/*.conf — add 'include conf.d/*.conf;' inside the http { } block, then re-run."
    fi
    run nginx -t
    run systemctl enable --now nginx
    run systemctl reload nginx

    step "Creating the first administrator"
    note "You'll be asked for a username and password now."
    ( cd "$PANEL_DIR" && php artisan p:user:make --admin=1 --email="$EMAIL" ) \
        || note "Admin creation was skipped or failed — run it yourself later: cd $PANEL_DIR && php artisan p:user:make"

    printf '\n\033[1;32mPanel installed.\033[0m\n'
    printf '  Open      : http://%s\n' "$FQDN"
    printf '  Files     : %s\n' "$PANEL_DIR"
    printf '  Database  : %s (user %s, password stored in %s/.env)\n' "$DB_NAME" "$DB_USER" "$PANEL_DIR"
    printf '\nTwo things this did NOT do, on purpose:\n'
    printf '  * No firewall port was opened. Decide that in the Firewall screen.\n'
    printf '  * No TLS certificate. Over a Tailscale tailnet the tunnel already\n'
    printf '    encrypts traffic; on a public domain, add one before real use.\n'
    printf '\nNext: install the daemon that runs game servers:  sudo outlaw-pterodactyl wings\n'
}

# --------------------------------------------------------------------------
install_wings() {
    need_root wings
    step "Checking Docker"
    command -v docker >/dev/null 2>&1 || die "Docker is not installed. Install it from the panel's Apps screen, or: pacman -S docker && systemctl enable --now docker"
    systemctl is-active --quiet docker || run systemctl enable --now docker

    step "Downloading wings"
    local ARCH
    case "$(uname -m)" in
        x86_64)  ARCH=amd64 ;;
        aarch64) ARCH=arm64 ;;
        *) die "unsupported architecture: $(uname -m)" ;;
    esac
    install -d -m 700 /etc/pterodactyl
    run curl -L -o /usr/local/bin/wings "https://github.com/pterodactyl/wings/releases/latest/download/wings_linux_$ARCH"
    run chmod u+x /usr/local/bin/wings

    step "Adding the wings service"
    cat > /etc/systemd/system/wings.service <<'UNIT'
[Unit]
Description=Pterodactyl Wings Daemon
After=docker.service
Requires=docker.service
PartOf=docker.service

[Service]
User=root
WorkingDirectory=/etc/pterodactyl
LimitNOFILE=4096
PIDFile=/var/run/wings/daemon.pid
ExecStart=/usr/local/bin/wings
Restart=on-failure
StartLimitInterval=180
StartLimitBurst=30
RestartSec=5s

[Install]
WantedBy=multi-user.target
UNIT
    run systemctl daemon-reload

    printf '\n\033[1;32mWings installed.\033[0m\n'
    printf 'It is NOT started yet, and that is correct: wings will not run without a\n'
    printf 'node configuration, and only your panel can produce one.\n\n'
    printf '  1. In the panel, go to Admin -> Nodes -> Create Node.\n'
    printf '  2. Open the new node, then its "Configuration" tab.\n'
    printf '  3. Save what it shows to /etc/pterodactyl/config.yml on this machine.\n'
    printf '  4. Start it:  sudo systemctl enable --now wings\n\n'
    printf 'Game servers will need their ports opened in the Firewall screen.\n'
}

# --------------------------------------------------------------------------
case "${1:-help}" in
    panel) shift; install_panel "$@" ;;
    wings) shift; install_wings ;;
    status) status_report ;;
    help|-h|--help) usage ;;
    *) echo "unknown command: $1" >&2; echo; usage; exit 2 ;;
esac
