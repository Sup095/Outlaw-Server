#-------------------------------------------------
# Outlaw OS — taskbar (tint2)
# A slim bottom bar listing every open window. Left-click a task to
# minimize/restore it; middle-click to close. The Outlaw desktop shell is the
# frameless backdrop and hides itself from the bar (skipTaskbar).
#-------------------------------------------------

# Background 1 — the panel itself
rounded = 0
border_width = 1
background_color = #0a0e0a 100
border_color = #143d0d 100

# Background 2 — the active/focused task
rounded = 3
border_width = 1
background_color = #143d0d 100
border_color = #33ff00 100

# Background 3 — normal + minimized tasks
rounded = 3
border_width = 0
background_color = #0d130d 85
border_color = #000000 0

# Panel
panel_items = T
panel_size = 100% 32
panel_margin = 0 0
panel_padding = 4 2 4
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
wm_menu = 1
font_shadow = 0

# Taskbar
taskbar_mode = single_desktop
taskbar_padding = 2 0 4
taskbar_background_id = 0

# Tasks
task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 240 30
task_padding = 7 2 7
task_font = sans 9
task_font_color = #b9ffb0 100
task_active_font_color = #33ff00 100
task_background_id = 3
task_active_background_id = 2
task_iconified_background_id = 3
task_urgent_background_id = 2

# Mouse — Windows-like: click toggles minimize/restore, middle closes
mouse_left = toggle_iconify
mouse_middle = close
mouse_right = none
mouse_scroll_up = prev_task
mouse_scroll_down = next_task
